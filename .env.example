# ---------------------------------------------------------------------------
# Public Health LMS - environment configuration
# Copy to .env and fill in. Never commit the filled file.
# ---------------------------------------------------------------------------

# Core -----------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-64
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Database -------------------------------------------------------------------
# Leave unset for SQLite (zero-config local development).
# DATABASE_URL=postgres://phlms:phlms@db:5432/public_health_lms
POSTGRES_DB=public_health_lms
POSTGRES_USER=phlms
POSTGRES_PASSWORD=change-me

# Frontend -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication -------------------------------------------------------------
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=ph_refresh
REFRESH_COOKIE_SAMESITE=Lax
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
THROTTLE_LOGIN=10/min
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_UPLOAD=120/hour

# Uploads --------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,doc,docx,ppt,pptx,xls,xlsx,csv,txt,png,jpg,jpeg,gif,webp,mp4,zip
# MEDIA_ROOT=/srv/public-health-lms/media

# Cache and background jobs --------------------------------------------------
# Leave REDIS_URL unset to run tasks inline and cache in memory.
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1

# Email ----------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@sph.srmist.local

# Localisation ---------------------------------------------------------------
TIME_ZONE=Asia/Kolkata
LANGUAGE_CODE=en-us

# Observability --------------------------------------------------------------
LOG_LEVEL=INFO
